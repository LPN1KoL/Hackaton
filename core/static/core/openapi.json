{
  "openapi": "3.0.3",
  "info": {
    "title": "Разметка зон на чертеже",
    "version": "0.1.0",
    "description": "Приём чертежей в DXF, отрисовка в SVG и полный конвейер озеленения: разметка, подбор растений LLM с обоснованиями, рассадка по нормам, итоговый DXF.\n\nОба метода принимают `multipart/form-data` и отвечают JSON.\nФайл проверяется дважды: по расширению `.dxf` и по началу содержимого —\nлибо сигнатура `AutoCAD Binary DXF`, либо групповой код `0`/`999` и слово `SECTION`\nв первом килобайте.\n\n**CSRF.** Django требует токен на любом POST. Токен приходит в cookie `csrftoken`\nпри открытии любой страницы сайта и повторяется в заголовке `X-CSRFToken`.\nКнопка «Try it out» ниже подставляет его сама.\n"
  },
  "servers": [
    {
      "url": "/",
      "description": "Текущий хост"
    }
  ],
  "tags": [
    {
      "name": "Чертежи",
      "description": "Превью и обработка"
    },
    {
      "name": "Документация",
      "description": "Эта страница"
    }
  ],
  "paths": {
    "/preview/": {
      "post": {
        "tags": [
          "Чертежи"
        ],
        "summary": "Превью чертежа",
        "description": "Отрисовывает DXF в SVG, ничего не сохраняя. Используется фронтендом сразу после\nвыбора файла, если включён флаг `PREVIEW_ON_UPLOAD`.\n",
        "operationId": "preview",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Чертёж в формате DXF, ASCII или binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Файл разобран",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Drawing"
                },
                "examples": {
                  "withGeometry": {
                    "summary": "Чертёж с геометрией",
                    "value": {
                      "name": "test.dxf",
                      "size": 950,
                      "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 884173 618595\">…</svg>",
                      "layers": [
                        {
                          "name": "0",
                          "color": 7,
                          "visible": true
                        },
                        {
                          "name": "Defpoints",
                          "color": 7,
                          "visible": true
                        }
                      ],
                      "note": null
                    }
                  },
                  "empty": {
                    "summary": "Геометрии нет",
                    "value": {
                      "name": "empty.dxf",
                      "size": 402,
                      "svg": null,
                      "layers": [],
                      "note": "В файле нет геометрии для отрисовки."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadFile"
          },
          "403": {
            "$ref": "#/components/responses/NoCsrf"
          },
          "405": {
            "$ref": "#/components/responses/WrongMethod"
          }
        }
      }
    },
    "/upload/": {
      "post": {
        "tags": [
          "Чертежи"
        ],
        "summary": "Запуск обработки чертежа",
        "description": "Принимает чертёж (и необязательно геоподоснову) и запускает в фоне конвейер greening: разметка → подбор растений LLM → рассадка → DXF. Отвечает сразу номером задачи; ход — `GET /jobs/{job}/`, результаты — `GET /jobs/{job}/{kind}/`.\n",
        "operationId": "upload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Чертёж в формате DXF"
                  },
                  "geobase": {
                    "type": "string",
                    "format": "binary",
                    "description": "Геоподоснова в формате DXF (необязательно)"
                  },
                  "preferences": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Пожелания к подбору растений (необязательно): текст уходит в запрос LLM, нормы и справочник важнее"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Задача запущена",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "job",
                    "name",
                    "size"
                  ],
                  "properties": {
                    "job": {
                      "type": "string",
                      "description": "Номер задачи (32 шестнадцатеричных символа)"
                    },
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "description": "Размер чертежа, байт"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadFile"
          }
        }
      }
    },
    "/params/": {
      "get": {
        "tags": [
          "Чертежи"
        ],
        "summary": "Параметры рассадки",
        "operationId": "params_schema",
        "description": "Описание параметров рассадки для редактирования результата (уровень 2): группы, ключи, тип (float, int, sizes — список целых, choice), пределы, шаг, единицы, значение по умолчанию, в каком режиме рассадки действует (both, model, algorithm).",
        "responses": {
          "200": {
            "description": "Описание",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "params": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "group": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "mode": {
                            "type": "string",
                            "enum": [
                              "both",
                              "model",
                              "algorithm"
                            ]
                          },
                          "title": {
                            "type": "string"
                          },
                          "help": {
                            "type": "string"
                          },
                          "min": {
                            "type": "number"
                          },
                          "max": {
                            "type": "number"
                          },
                          "step": {
                            "type": "number"
                          },
                          "unit": {
                            "type": "string"
                          },
                          "optional": {
                            "type": "boolean"
                          },
                          "default": {}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs/": {
      "get": {
        "tags": [
          "Документация"
        ],
        "summary": "Страница документации",
        "description": "Swagger UI поверх этой же спеки.",
        "operationId": "docsPage",
        "security": [],
        "responses": {
          "200": {
            "description": "HTML-страница",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Документация"
        ],
        "summary": "Спека в JSON",
        "description": "Отдаёт этот документ целиком. CSRF-токен не нужен: запрос ничего не меняет.",
        "operationId": "docsSchema",
        "security": [],
        "responses": {
          "200": {
            "description": "Документ OpenAPI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job}/": {
      "get": {
        "tags": [
          "Чертежи"
        ],
        "summary": "Ход обработки",
        "operationId": "job",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Состояние задачи",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "done",
                        "error",
                        "cancelled"
                      ]
                    },
                    "stage": {
                      "type": "string",
                      "enum": [
                        "markup",
                        "llm",
                        "placement",
                        "dxf",
                        "view"
                      ],
                      "description": "Текущий этап"
                    },
                    "stage_title": {
                      "type": "string"
                    },
                    "done": {
                      "type": "integer",
                      "nullable": true,
                      "description": "Этап llm: сколько структур готово"
                    },
                    "total": {
                      "type": "integer",
                      "nullable": true,
                      "description": "Этап llm: сколько всего"
                    },
                    "error": {
                      "type": "string",
                      "description": "При state=error или cancelled — причина"
                    },
                    "summary": {
                      "type": "object",
                      "description": "При state=done: структуры, зоны, растения, нарушения"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Нет такой задачи"
          }
        },
        "description": "Опрашивайте не реже раза в 3 минуты (GREENING_JOB_ABANDON_S): задача без опросов считается брошенной и отменяется — в очереди снимается, в работе останавливается на ближайшем этапе."
      }
    },
    "/jobs/{job}/{kind}/": {
      "get": {
        "tags": [
          "Чертежи"
        ],
        "summary": "Результат обработки",
        "operationId": "job_result",
        "description": "`dxf` — исходный чертёж со слоями рассадки `Greening_*`; `report` — обоснование: по каждой посадке растение, приём, количество, обоснование, нормы с пунктами НПА, свойства, предупреждения; по каждой зоне — место, решение, что закрыло деревья и кустарники; отклонённые посадки с причиной (то же, что карточки просмотра); `plan` — полный план подбора со служебными полями; `placement` — рассадка в GeoJSON; `view` — данные интерактивного просмотра.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "dxf",
                "report",
                "plan",
                "placement",
                "view"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Файл результата"
          },
          "404": {
            "description": "Нет задачи или результат ещё не готов"
          }
        }
      }
    },
    "/jobs/{job}/cancel/": {
      "post": {
        "tags": [
          "Чертежи"
        ],
        "summary": "Отменить обработку",
        "operationId": "job_cancel",
        "description": "Задача в очереди или в работе отменяется (state=cancelled) и освобождает очередь. Страница шлёт отмену сама, когда её закрывают. Готовая задача не меняется.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Отмена принята",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Нет такой задачи"
          }
        }
      }
    },
    "/jobs/{job}/revise/": {
      "post": {
        "tags": [
          "Чертежи"
        ],
        "summary": "Пересчитать: пожелания к растениям и/или параметры рассадки",
        "operationId": "job_revise",
        "description": "Редактирование результата. Создаёт новую задачу — версию готовой: те же входные файлы, разметка берётся из исходной задачи (не считается заново). Уровень 1 — preferences: новые пожелания к растениям уходят в запрос LLM, подбор растений заново. Уровень 2 — params: параметры рассадки (список, пределы и значения по умолчанию — GET /params/); если пожелания не менялись, подбор растений берётся из исходной задачи и LLM не вызывается — пересчитываются рассадка, проверка отступов, DXF и обоснования. Параметры накапливаются по версиям: новые поверх параметров исходной. Нет поля preferences — пожелания прежние, пустое — пожелания сняты. Нормы параметрами не меняются. Исходная задача не меняется; ход и результаты новой — как у /upload/, в её статусе parent, preferences, params.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "номер готовой задачи"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "preferences": {
                    "type": "string",
                    "maxLength": 2000,
                    "example": "больше хвойных, без тополей",
                    "description": "Пожелания к подбору растений (уровень 1)"
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": true,
                    "example": {
                      "placement": "model",
                      "tree_unit_spacing_m": 12,
                      "group_sizes_small": [
                        3,
                        5
                      ],
                      "solitary_max_tree": 2,
                      "style_mode": "landscape",
                      "seed": 7
                    },
                    "description": "Параметры рассадки {ключ: значение} (уровень 2), ключи — GET /params/. В форме — JSON-строкой"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "preferences": {
                    "type": "string",
                    "maxLength": 2000,
                    "example": "больше хвойных, без тополей",
                    "description": "Пожелания к подбору растений (уровень 1)"
                  },
                  "params": {
                    "type": "string",
                    "additionalProperties": true,
                    "example": {
                      "placement": "model",
                      "tree_unit_spacing_m": 12,
                      "group_sizes_small": [
                        3,
                        5
                      ],
                      "solitary_max_tree": 2,
                      "style_mode": "landscape",
                      "seed": 7
                    },
                    "description": "Параметры рассадки {ключ: значение} (уровень 2), ключи — GET /params/. В форме — JSON-строкой"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "preferences": {
                    "type": "string",
                    "maxLength": 2000,
                    "example": "больше хвойных, без тополей",
                    "description": "Пожелания к подбору растений (уровень 1)"
                  },
                  "params": {
                    "type": "string",
                    "additionalProperties": true,
                    "example": {
                      "placement": "model",
                      "tree_unit_spacing_m": 12,
                      "group_sizes_small": [
                        3,
                        5
                      ],
                      "solitary_max_tree": 2,
                      "style_mode": "landscape",
                      "seed": 7
                    },
                    "description": "Параметры рассадки {ключ: значение} (уровень 2), ключи — GET /params/. В форме — JSON-строкой"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Пересчёт запущен",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": "string",
                      "description": "номер новой задачи"
                    },
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "parent": {
                      "type": "string",
                      "description": "номер исходной задачи"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Нет ни пожеланий, ни параметров; неверное значение параметра ({\"errors\": {\"params.ключ\": [\"…\"]}})"
          },
          "404": {
            "description": "Нет такой задачи"
          },
          "409": {
            "description": "Исходная задача ещё не готова"
          }
        }
      }
    },
    "/jobs/{job}/move/": {
      "post": {
        "tags": [
          "Чертежи"
        ],
        "summary": "Сохранить перемещения растений",
        "operationId": "job_move",
        "description": "Редактирование результата, уровень 3: растения, передвинутые мышью на сайте. Новая задача — версия готовой: растения стоят там, куда их передвинули (координаты чертежа); рассадка заново не считается, заново — проверка правил (verify), проверка отступов по чертежу, DXF, просмотр и обоснования. Растение вне разрешённой зоны или ближе нормы не запрещается, а попадает в нарушения. Номера растений (R00001…) — в placement.geojson и view.json. Пересчёт пожеланий или параметров после этого строит рассадку заново — перемещения пропадают.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "moves"
                ],
                "properties": {
                  "moves": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "x",
                        "y"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "R00012"
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Сохранение запущено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "parent": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Нет перемещений или они неверны"
          },
          "404": {
            "description": "Нет такой задачи"
          },
          "409": {
            "description": "Исходная задача ещё не готова"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRFToken",
        "description": "Значение cookie `csrftoken`, полученной при открытии любой страницы сайта."
      }
    },
    "responses": {
      "BadFile": {
        "description": "Файл не прошёл проверку или его не удалось разобрать.\nКлюч в `errors` — имя поля формы, значение — список сообщений.\n",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Errors"
            },
            "examples": {
              "extension": {
                "summary": "Не тот формат",
                "value": {
                  "errors": {
                    "file": [
                      "Ожидается файл с расширением .dxf."
                    ]
                  }
                }
              },
              "content": {
                "summary": "Содержимое не похоже на DXF",
                "value": {
                  "errors": {
                    "file": [
                      "Содержимое файла не похоже на DXF."
                    ]
                  }
                }
              },
              "broken": {
                "summary": "Файл не разобрался",
                "value": {
                  "errors": {
                    "file": [
                      "Не удалось разобрать файл: …"
                    ]
                  }
                }
              },
              "missing": {
                "summary": "Поле не заполнено",
                "value": {
                  "errors": {
                    "file": [
                      "Обязательное поле."
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "NoCsrf": {
        "description": "Нет CSRF-токена или он не совпал с cookie. Ответ — HTML-страница Django, не JSON.",
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "WrongMethod": {
